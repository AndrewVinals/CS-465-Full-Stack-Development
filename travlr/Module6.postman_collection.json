{
  "info": {
    "name": "Travlr Module Six CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "List trips",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Add Sunset Reef",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SUNR261201\",\n  \"name\": \"Sunset Reef\",\n  \"length\": \"5 nights / 6 days\",\n  \"start\": \"2026-12-01\",\n  \"resort\": \"Sunset Bay, 4 stars\",\n  \"perPerson\": \"1299.00\",\n  \"image\": \"reef1.jpg\",\n  \"description\": \"Enjoy clear water, reef diving, and a relaxing beach getaway.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "Find Sunset Reef",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/SUNR261201"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Sunset Reef",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/SUNR261201",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"SUNR261201\",\n  \"name\": \"Sunset Reef\",\n  \"length\": \"5 nights / 6 days\",\n  \"start\": \"2026-12-01\",\n  \"resort\": \"Sunset Bay, 4 stars\",\n  \"perPerson\": \"1399.00\",\n  \"image\": \"reef1.jpg\",\n  \"description\": \"Enjoy clear water, reef diving, and a relaxing beach getaway.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Sunset Reef (run after screenshots)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/trips/SUNR261201"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected status 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    }
  ]
}